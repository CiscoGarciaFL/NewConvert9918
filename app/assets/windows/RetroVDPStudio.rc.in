IDI_ICON1 ICON "@RETROVDP_WINDOWS_ICON@"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CiscoGarciaFL\0"
            VALUE "FileDescription", "RetroVDP Studio\0"
            VALUE "FileVersion", "@RETROVDP_VERSION@\0"
            VALUE "InternalName", "RetroVDPStudio\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Cisco Garcia / CiscoGarciaFL\0"
            VALUE "OriginalFilename", "RetroVDPStudio.exe\0"
            VALUE "ProductName", "RetroVDP Studio\0"
            VALUE "ProductVersion", "@RETROVDP_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
