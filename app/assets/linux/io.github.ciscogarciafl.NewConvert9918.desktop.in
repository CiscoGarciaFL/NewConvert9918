[Desktop Entry]
Type=Application
Version=1.0
Name=New Convert 9918
Comment=Convert images for TMS9918A and F18A graphics hardware
Exec=NewConvert9918 %f
Icon=@NEWCONVERT9918_LINUX_APP_ID@
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/bmp;image/gif;image/tiff;image/webp;
StartupNotify=true
StartupWMClass=NewConvert9918
X-AppImage-Version=@NEWCONVERT9918_VERSION@
