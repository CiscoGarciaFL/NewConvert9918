{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows Debug (Qt MinGW)",
      "description": "Qt 6.10.3 and MinGW 13.1 installed by the Qt toolchain",
      "inherits": "debug-base",
      "generator": "MinGW Makefiles",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.10.3/mingw_64",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/Qt/Tools/mingw1310_64/bin/mingw32-make.exe"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (GCC or Clang)",
      "description": "Uses the C++ compiler and Qt installation discoverable in the environment",
      "inherits": "debug-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug (AppleClang)",
      "description": "Uses AppleClang and a Qt installation discoverable in the environment",
      "inherits": "debug-base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "ci-release",
      "displayName": "Continuous Integration Release",
      "description": "Portable Ninja build using the compiler and Qt selected by the CI runner",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug",
      "jobs": 4
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "jobs": 4
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "jobs": 4
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw-debug",
      "configurePreset": "windows-mingw-debug",
      "environment": {
        "PATH": "C:/Qt/6.10.3/mingw_64/bin;C:/Qt/Tools/mingw1310_64/bin;$penv{PATH}"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
